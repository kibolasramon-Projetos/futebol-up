rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function adm() { return request.auth != null && request.auth.token.email.lower() == 'kibolasramon@yahoo.com.br'; }
    function eu() { return /databases/$(database)/documents/colaboradores/$(request.auth.uid); }
    function membro() { return adm() || (request.auth != null && exists(eu()) && get(eu()).data.ativo == true); }
    function edita() { return adm() || (membro() && get(eu()).data.papel == 'editor'); }
    match /colaboradores/{uid} {
      allow read: if membro() || (request.auth != null && request.auth.uid == uid);
      allow write: if adm();
    }
    match /{col}/{doc=**} {
      allow read: if col != 'colaboradores' && membro();
      allow write: if col != 'colaboradores' && edita();
    }
  }
}
